# Copie este arquivo para .env (na mesma pasta) e preencha os valores.
# Formato: NOME=valor, sem espaços ao redor do "=" e sem aspas.

# Modelo de IA (obrigatória para os agentes rodarem)
OPENAI_API_KEY=

# Banco de dados
DATABASE_URL=postgresql+pg8000://usuario:senha@localhost:5432/dedalos

# Materials Project (chave grátis em https://next-gen.materialsproject.org/api)
MaterialsProject=

# Firecrawl (opcional: sem chave usa o modo gratuito com limite diário por IP)
FIRECRAWL_API_KEY=
FIRECRAWL_LIMITE_CREDITOS_PROJETO=150

# OpenAlex (opcional, aumenta o limite diário) e e-mail de contato
# (obrigatório para o Unpaywall; também identifica o projeto para Wikipedia, Wikidata, AFLOW e OQMD)
OPENALEX_API_KEY=
DAEDALUS_EMAIL_CONTATO=

# Opcional: validade do cache das páginas lidas, em dias (padrão: 90)
# DAEDALUS_DIAS_VALIDADE_CACHE=90
